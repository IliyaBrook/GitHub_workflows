#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
EVENT_PATH="${1:-${GITHUB_EVENT_PATH:-}}"

if [[ -z "$EVENT_PATH" || ! -f "$EVENT_PATH" ]]; then
  echo "Missing GitHub event payload path" >&2
  exit 2
fi

if ! command -v jq >/dev/null 2>&1; then
  echo "jq is required" >&2
  exit 2
fi

EVENT_NAME="${GITHUB_EVENT_NAME:-}"
if [[ -z "$EVENT_NAME" ]]; then
  EVENT_NAME="$(jq -r '
    if has("comment") and has("issue") then "issue_comment"
    elif has("issue") then "issues"
    elif has("comment") and has("discussion") then "discussion_comment"
    elif has("discussion") then "discussion"
    else "unknown"
    end
  ' "$EVENT_PATH")"
fi

case "$EVENT_NAME" in
  issues|issue_comment)
    exec "$SCRIPT_DIR/openclaw-github-issue-responder" "$@"
    ;;
  discussion|discussion_comment)
    exec "$SCRIPT_DIR/openclaw-github-discussion-responder" "$@"
    ;;
  *)
    echo "NO_REPLY event=$EVENT_NAME"
    exit 0
    ;;
esac
